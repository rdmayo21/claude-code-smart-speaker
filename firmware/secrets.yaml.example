# Copy to secrets.yaml (gitignored). flash.sh asks for the Wi-Fi password if you leave the marker.
wifi_ssid: "your Wi-Fi name (2.4 GHz)"
wifi_password: "__ASK_AT_FLASH__"
ota_password: "any long random string"
api_key: "44-char base64: python3 -c 'import base64,os;print(base64.b64encode(os.urandom(32)).decode())'"
