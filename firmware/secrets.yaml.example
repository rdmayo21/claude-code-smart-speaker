# Made for you by:  uv run bridge.py --make-secrets "your Wi-Fi name"   (writes secrets.yaml, mode 600)
# wifi_password stays as the marker; flash.sh asks for it. ota_password protects later
# over-the-air flashes (keep it); api_key is required by the firmware and otherwise unused.
wifi_ssid: "your Wi-Fi name (2.4 GHz)"
wifi_password: "__ASK_AT_FLASH__"
ota_password: "any long random string"
api_key: "44 characters of base64"
